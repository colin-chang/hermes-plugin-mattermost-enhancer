# Mattermost Enhancer callback endpoint.
# Keep real values in ~/.hermes/.env; never commit that file.

# Required when Mattermost runs in Docker and Hermes runs on the host.
MATTERMOST_CALLBACK_BIND=0.0.0.0
MATTERMOST_CALLBACK_PORT=18065
MATTERMOST_CALLBACK_URL=http://host.docker.internal:18065/mattermost/callback

# Recommended whenever the callback endpoint is reachable beyond localhost.
# Generate a long random value, for example: openssl rand -hex 32
MATTERMOST_CALLBACK_SECRET=replace-with-a-long-random-secret
